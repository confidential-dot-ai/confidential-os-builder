#!/usr/bin/env python3
"""Print the JSON list of image recipes affected by changes from --base to HEAD.

Reads ci/images.json and maps changed profiles/shared inputs to their recipe
consumers. general-purpose.yml uses the list as its build matrix; base.yml and
base-repro-gate.yml check whether it contains "base". Does not build images.

Example: bin/ci-images --base origin/main --omit-base
Output: ["general-purpose", "general-purpose-gpu"] when both are affected.
--all or an unavailable base selects all recipes; unrelated docs select none.
See ci/README.md for the registry and docs/IMAGE-CI.md for selection rules.
"""

import argparse
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]


def affected(recipes, paths):
    selected = set()
    for path in paths:
        if path == "ci/README.md":
            continue
        parts = Path(path).parts
        if len(parts) >= 5 and parts[:3] == ("mkosi", "base", "mkosi.profiles"):
            if len(parts) == 5 and parts[4] == "README.md":
                continue
            profile = parts[3]
            selected.update(name for name, recipe in recipes.items() if profile in recipe["profiles"])
        elif path.startswith("kernel/") and (
            path.endswith(".config") or Path(path).name.startswith("config-x86_64") or path.endswith(".crt")
        ) and path not in ("kernel/required.config", "kernel/hardening.config", "kernel/confidential.config", "kernel/config-x86_64.snapshot"):
            selected.update(
                name for name, recipe in recipes.items()
                if path == recipe["kernel"] or path in recipe["extra_kernel_inputs"]
                or (recipe["kernel"] and path == f"kernel/config-x86_64-{Path(recipe['kernel']).stem}.snapshot")
            )
        elif path in ("bin/confos-fetch-gpu", "bin/lib/gpu-module-cache.sh"):
            selected.update(name for name, recipe in recipes.items() if "gpu" in recipe["profiles"])
        elif path.startswith(("mkosi/", "kernel/", "src/", "crates/", "bin/", "firmware/", "ci/", ".github/actions/")) or path in (
            "Cargo.toml", "Cargo.lock", ".github/workflows/general-purpose.yml",
            ".github/workflows/base.yml", ".github/workflows/base-repro-gate.yml",
        ):
            selected.update(recipes)
    return sorted(selected)


def changed(base):
    if not base or set(base) == {"0"}:
        return None
    # GitHub's first branch push or a force push can lack the old object.
    # Build everything rather than silently skipping an image.
    if subprocess.run(["git", "cat-file", "-e", f"{base}^{{commit}}"], cwd=ROOT, capture_output=True).returncode:
        print("Previous commit unavailable; selecting all images", file=sys.stderr)
        return None
    result = subprocess.run(["git", "diff", "--name-only", "-z", base, "HEAD"], cwd=ROOT, check=True, stdout=subprocess.PIPE)
    return result.stdout.decode().rstrip("\0").split("\0") if result.stdout else []


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--base", help="Git commit to compare with HEAD")
    parser.add_argument("--all", action="store_true", help="select all registered recipes without inspecting a diff")
    parser.add_argument("--omit-base", action="store_true", help="exclude the base recipe handled by its own workflow")
    args = parser.parse_args()
    recipes = json.loads((ROOT / "ci/images.json").read_text())
    paths = None if args.all else changed(args.base)
    names = sorted(recipes) if paths is None else affected(recipes, paths)
    if args.omit_base:
        names = [name for name in names if name != "base"]
    print(json.dumps(names))


if __name__ == "__main__":
    main()
