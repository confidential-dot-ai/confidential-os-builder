#!/usr/bin/env bash
#
# Turn the working tree into release VERSION: bump the package version in
# Cargo.toml and Cargo.lock, and roll CHANGELOG.md's [Unreleased] entries
# into a section dated DATE. Touches nothing unless every check passes, and
# does no git or network work — the caller commits.
#
# The section opens with a lead paragraph on measurements, which is what
# consumers read first (docs/VERSIONING.md). RELEASE_SUMMARY, when set, is
# that paragraph. Otherwise a standard one is written if any entry is
# marked "Alters measurements". No marked entry means no lead: a release is
# never declared measurement-neutral on the strength of a missing marker.

set -euo pipefail

readonly VERSION_RE='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'

die() {
  echo "${0##*/}: $*" >&2
  exit 1
}

# Print the [package] table's value for KEY.
package_field() {
  awk -v key="$2" '
    /^\[/ { in_package = ($0 == "[package]") }
    in_package && $1 == key && $2 == "=" {
      gsub(/"/, "", $3); print $3; exit
    }
  ' "$1"
}

newer_than() {
  local -a new old
  local i
  IFS=. read -r -a new <<<"$1"
  IFS=. read -r -a old <<<"$2"
  for i in 0 1 2; do
    if [ "${new[i]}" -gt "${old[i]}" ]; then return 0; fi
    if [ "${new[i]}" -lt "${old[i]}" ]; then return 1; fi
  done
  return 1
}

readonly STANDARD_LEAD='**Changes measurements.** Images built from this
release have new measurements; the entries below marked **Alters
measurements** say which images and why. Rebuild images, publish their
manifests and update verifier reference values before rollout. See
[Versioning](docs/VERSIONING.md) for the migration policy.'

# Print FILE's [Unreleased] section, without its heading.
unreleased_section() {
  awk '
    /^## \[/ { in_unreleased = ($0 == "## [Unreleased]"); next }
    /^\[[^]]*\]: / { in_unreleased = 0 }
    in_unreleased { print }
  ' "$1"
}

# Reflow stdin into one paragraph of lines no longer than 78 columns.
wrap() {
  awk '
    { for (i = 1; i <= NF; i++) {
        if (line == "") line = $i
        else if (length(line) + 1 + length($i) <= 78) line = line " " $i
        else { print line; line = $i }
    } }
    END { if (line != "") print line }
  '
}

main() {
  if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
    echo "usage: prepare-release VERSION DATE [DIR]" >&2
    return 2
  fi

  local version=$1 date=$2 dir=${3:-.}
  local date_re='^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
  local manifest="$dir/Cargo.toml" lock="$dir/Cargo.lock" changelog="$dir/CHANGELOG.md"
  local name current previous file
  local new_manifest new_lock new_changelog section lead

  [[ "$version" =~ $VERSION_RE ]] || die "invalid version: $version (want X.Y.Z)"
  [[ "$date" =~ $date_re ]] || die "invalid date: $date (want YYYY-MM-DD)"
  for file in "$manifest" "$lock" "$changelog"; do
    [ -f "$file" ] || die "not found: $file"
  done

  name=$(package_field "$manifest" name)
  current=$(package_field "$manifest" version)
  [ -n "$name" ] || die "no [package] name in $manifest"
  [[ "$current" =~ $VERSION_RE ]] || die "no [package] version in $manifest"
  newer_than "$version" "$current" || die "$version is not newer than $current"

  grep -qx '## \[Unreleased\]' "$changelog" || die "no [Unreleased] section in $changelog"
  if grep -q "^## \[$version\]" "$changelog"; then
    die "$changelog already has a [$version] section"
  fi
  section=$(unreleased_section "$changelog")
  grep -q '[^[:space:]]' <<<"$section" || die "nothing under [Unreleased] in $changelog"

  lead=$(wrap <<<"${RELEASE_SUMMARY-}")
  if ! grep -m1 '[^[:space:]]' <<<"$section" | grep -q '^#'; then
    # Text before the first subsection: someone already wrote the lead.
    [ -z "$lead" ] || die "[Unreleased] already opens with a lead paragraph"
  elif [ -z "$lead" ] && grep -qi 'alters measurements' <<<"$section"; then
    lead=$(wrap <<<"$STANDARD_LEAD")
  fi
  previous=$(sed -n 's|^\[Unreleased\]: .*/compare/v\(.*\)\.\.\.HEAD$|\1|p' "$changelog")
  [[ "$previous" =~ $VERSION_RE ]] ||
    die "no [Unreleased] compare link in $changelog"
  [ "$previous" = "$current" ] ||
    die "[Unreleased] compare link starts at v$previous, not v$current"

  new_manifest=$(awk -v version="$version" '
    /^\[/ { in_package = ($0 == "[package]") }
    in_package && !done && $1 == "version" && $2 == "=" {
      print "version = \"" version "\""; done = 1; next
    }
    { print }
    END { exit !done }
  ' "$manifest") || die "could not bump $manifest"

  new_lock=$(awk -v name="$name" -v current="$current" -v version="$version" '
    after_name && !done && $0 == "version = \"" current "\"" {
      print "version = \"" version "\""; done = 1; after_name = 0; next
    }
    { after_name = ($0 == "name = \"" name "\""); print }
    END { exit !done }
  ' "$lock") || die "no $name $current entry in $lock (is Cargo.lock stale?)"

  new_changelog=$(LEAD=$lead awk -v version="$version" -v date="$date" -v previous="$previous" '
    $0 == "## [Unreleased]" && !rolled {
      print; print ""; print "## [" version "] — " date
      if (ENVIRON["LEAD"] != "") { print ""; print ENVIRON["LEAD"] }
      rolled = 1; next
    }
    /^\[Unreleased\]: / && !linked {
      base = $2; sub(/\/compare\/.*$/, "", base)
      print "[Unreleased]: " base "/compare/v" version "...HEAD"
      print "[" version "]: " base "/compare/v" previous "...v" version
      linked = 1; next
    }
    { print }
    END { exit !(rolled && linked) }
  ' "$changelog") || die "could not roll $changelog"

  printf '%s\n' "$new_manifest" >"$manifest"
  printf '%s\n' "$new_lock" >"$lock"
  printf '%s\n' "$new_changelog" >"$changelog"
  echo "prepare-release: $name $current -> $version ($date)"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
