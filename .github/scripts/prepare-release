#!/usr/bin/env bash
#
# Turn the working tree into release VERSION: bump the package version in
# Cargo.toml and Cargo.lock, and roll CHANGELOG.md's [Unreleased] entries
# into a section dated DATE. Touches nothing unless every check passes, and
# does no git or network work — the caller commits.

set -euo pipefail

die() {
  echo "prepare-release: $*" >&2
  exit 1
}

# Print the [package] table's value for KEY.
package_field() {
  awk -v key="$2" '
    /^\[/ { in_package = ($0 == "[package]") }
    in_package && $1 == key && $2 == "=" {
      gsub(/"/, "", $3); print $3; exit
    }
  ' "$1"
}

newer_than() {
  local -a new old
  local i
  IFS=. read -r -a new <<<"$1"
  IFS=. read -r -a old <<<"$2"
  for i in 0 1 2; do
    if [ "${new[i]}" -gt "${old[i]}" ]; then return 0; fi
    if [ "${new[i]}" -lt "${old[i]}" ]; then return 1; fi
  done
  return 1
}

main() {
  if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
    echo "usage: prepare-release VERSION DATE [DIR]" >&2
    return 2
  fi

  local version=$1 date=$2 dir=${3:-.}
  local version_re='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
  local date_re='^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
  local manifest="$dir/Cargo.toml" lock="$dir/Cargo.lock" changelog="$dir/CHANGELOG.md"
  local name current previous file

  [[ "$version" =~ $version_re ]] || die "invalid version: $version (want X.Y.Z)"
  [[ "$date" =~ $date_re ]] || die "invalid date: $date (want YYYY-MM-DD)"
  for file in "$manifest" "$lock" "$changelog"; do
    [ -f "$file" ] || die "not found: $file"
  done

  name=$(package_field "$manifest" name)
  current=$(package_field "$manifest" version)
  [ -n "$name" ] || die "no [package] name in $manifest"
  [[ "$current" =~ $version_re ]] || die "no [package] version in $manifest"
  newer_than "$version" "$current" || die "$version is not newer than $current"

  grep -qx '## \[Unreleased\]' "$changelog" || die "no [Unreleased] section in $changelog"
  if grep -q "^## \[$version\]" "$changelog"; then
    die "$changelog already has a [$version] section"
  fi
  awk '
    /^## \[/ { in_unreleased = ($0 == "## [Unreleased]"); next }
    in_unreleased && /[^[:space:]]/ { found = 1 }
    END { exit !found }
  ' "$changelog" || die "nothing under [Unreleased] in $changelog"
  previous=$(sed -n 's|^\[Unreleased\]: .*/compare/v\(.*\)\.\.\.HEAD$|\1|p' "$changelog")
  [[ "$previous" =~ $version_re ]] ||
    die "no [Unreleased] compare link in $changelog"
  [ "$previous" = "$current" ] ||
    die "[Unreleased] compare link starts at v$previous, not v$current"

  # Not local: the EXIT trap runs after main has returned.
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/prepare-release.XXXXXXXX")
  trap 'rm -rf "$tmp"' EXIT

  awk -v version="$version" '
    /^\[/ { in_package = ($0 == "[package]") }
    in_package && !done && $1 == "version" && $2 == "=" {
      print "version = \"" version "\""; done = 1; next
    }
    { print }
    END { exit !done }
  ' "$manifest" >"$tmp/Cargo.toml" || die "could not bump $manifest"

  awk -v name="$name" -v current="$current" -v version="$version" '
    after_name && !done && $0 == "version = \"" current "\"" {
      print "version = \"" version "\""; done = 1; after_name = 0; next
    }
    { after_name = ($0 == "name = \"" name "\""); print }
    END { exit !done }
  ' "$lock" >"$tmp/Cargo.lock" || die "no $name $current entry in $lock (is Cargo.lock stale?)"

  awk -v version="$version" -v date="$date" -v previous="$previous" '
    $0 == "## [Unreleased]" && !rolled {
      print; print ""; print "## [" version "] — " date
      rolled = 1; next
    }
    /^\[Unreleased\]: / && !linked {
      base = $2; sub(/\/compare\/.*$/, "", base)
      print "[Unreleased]: " base "/compare/v" version "...HEAD"
      print "[" version "]: " base "/compare/v" previous "...v" version
      linked = 1; next
    }
    { print }
    END { exit !(rolled && linked) }
  ' "$changelog" >"$tmp/CHANGELOG.md" || die "could not roll $changelog"

  cat "$tmp/Cargo.toml" >"$manifest"
  cat "$tmp/Cargo.lock" >"$lock"
  cat "$tmp/CHANGELOG.md" >"$changelog"
  echo "prepare-release: $name $current -> $version ($date)"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
