# Azure confidential VMs (DCesv6 Intel TDX, Hyper-V/OpenHCL paravisor) on top
# of the general-purpose policy. Opt-in: does not change kernel/hardening.config
# or any default image. Built in (=y): the CPU lineage keeps CONFIG_MODULES off.

# ACPI: keep the trusted-AML gate, but build in Azure's own DSDT instead of
# kernel/trusted-dsdt.asl. Azure does not measure host ACPI anywhere (RTMR[0]
# is zero, no handoff event; see docs/CLOUD.md), so the gate is the only ACPI
# protection there. kernel/acpi/azure-dsdt.aml is the raw table captured from
# DCesv6 guests (sha256 309fd2df..., identical across reboot, redeploy and
# DC2/DC4 sizes; Azure ships no SSDT). If Azure changes its DSDT, this image
# keeps booting with the captured table; re-capture and rebuild to adopt it.
# confos-acpi: trusted kernel/acpi/azure-dsdt.aml

# Serial console (cloud serial-port logs). Re-enables the 8250 driver that
# hardening.config disables; the profile adds console=ttyS0 to the cmdline.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# Hyper-V VMBus (enumerated through the host DSDT), synthetic SCSI disks,
# synthetic NIC, vPCI and MANA for accelerated networking; NVMe disk option.
CONFIG_HYPERV=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_PCI_HYPERV=y
CONFIG_MICROSOFT_MANA=y
CONFIG_BLK_DEV_NVME=y

# Azure provisioning media (ovf-env.xml on a UDF DVD) for cloud-init.
CONFIG_BLK_DEV_SR=y
CONFIG_UDF_FS=y

# Paravisor vTPM (Azure attests the guest through it). Keep the TPM out of
# the kernel RNG; confos trusts RDRAND as before.
CONFIG_TCG_TPM=y
CONFIG_TCG_CRB=y
CONFIG_TCG_TIS=y
# CONFIG_HW_RANDOM_TPM is not set

# Shared workload policy; kept identical to kernel/general-purpose.config.
# Rootful OCI runtime APIs and Docker bridge networking.
# Opt-in: does not change kernel/hardening.config or the base image.
# BPF is required by runc's cgroup-v2 device controller. Unprivileged access
# defaults off; workload sysctls latch it off and harden privileged JIT use.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_CGROUP_BPF=y
CONFIG_USER_NS=y

# Enforce OCI memory/swap limits; otherwise Docker silently discards them.
CONFIG_MEMCG=y
CONFIG_CFS_BANDWIDTH=y

# Docker's nft-backed iptables, NAT, DNS and published ports.
# Retain the base ban on NETFILTER_XTABLES_LEGACY.
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_COMPAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_CONNTRACK_BRIDGE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y

# Application compatibility, not a requirement of the OCI runtime itself.
# io_uring grows unprivileged kernel attack surface; Docker's default seccomp
# policy still applies. Native/admin-launched processes are not sandboxed.
CONFIG_IO_URING=y

# Do not carry the PoC's optional CRIU/FUSE/VPN surfaces into this profile.
# Preserve KSPP system-mapping sealing and the base's kcmp exclusion.
# CONFIG_CHECKPOINT_RESTORE is not set
# CONFIG_KCMP is not set
# CONFIG_USERFAULTFD is not set
# CONFIG_FUSE_FS is not set
# CONFIG_TUN is not set
CONFIG_MSEAL_SYSTEM_MAPPINGS=y
