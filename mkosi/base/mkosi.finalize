#!/bin/bash
set -euo pipefail

# Empty machine-id so it doesn't vary between builds; systemd fills it in at
# boot (committed on a writable /etc, transient via /run on a read-only one).
: > "$BUILDROOT/etc/machine-id"
if [ -f "$BUILDROOT/var/lib/dbus/machine-id" ]; then
    : > "$BUILDROOT/var/lib/dbus/machine-id"
fi

# /etc/confai -> /run/confai: the initrd stages the operator pubkey under
# /run because /etc is read-only by default; consumers keep the stable
# /etc/confai/... path. Done here rather than as a checked-in symlink so a
# profile that baked a real dir there fails loudly instead of losing its
# files behind the link.
if [ -e "$BUILDROOT/etc/confai" ] && [ ! -L "$BUILDROOT/etc/confai" ]; then
    echo "mkosi.finalize: /etc/confai must stay free for the /run/confai symlink (a profile baked a real dir there)" >&2
    exit 1
fi
ln -snf ../run/confai "$BUILDROOT/etc/confai"

# Remove timestamped log content
rm -f "$BUILDROOT/var/log/dpkg.log"
rm -f "$BUILDROOT/var/log/alternatives.log"
rm -f "$BUILDROOT/var/log/bootstrap.log"
rm -rf "$BUILDROOT/var/log/journal"
rm -f "$BUILDROOT/var/log/apt/history.log"
rm -f "$BUILDROOT/var/log/apt/term.log"

# Remove caches with embedded timestamps
rm -f "$BUILDROOT/var/cache/ldconfig/aux-cache"
rm -rf "$BUILDROOT/var/cache/man"
rm -rf "$BUILDROOT/var/cache/apt"
rm -rf "$BUILDROOT/var/lib/apt/lists"

# Recreate /var/lib/dpkg/ — CleanPackageMetadata=yes wipes it, but apt
# refuses to open its lock file if the directory is missing.
mkdir -p "$BUILDROOT/var/lib/dpkg"

# Remove random seeds
rm -f "$BUILDROOT/var/lib/systemd/random-seed"
rm -f "$BUILDROOT/boot/efi/loader/random-seed"
rm -f "$BUILDROOT/efi/loader/random-seed"

# Remove SSH host keys — openssh-server's postinst generates them with random
# bytes at install time, breaking image reproducibility (different bytes per
# build). ssh.service regenerates them on first boot inside the guest, so each
# VM still gets unique keys. Standard cloud-image practice.
rm -f "$BUILDROOT"/etc/ssh/ssh_host_*

# Remove cargo cache if present (non-deterministic)
rm -rf "$BUILDROOT/root/.cargo"
