[Unit]
Description=Latch kernel.modules_disabled after the GPU driver is loaded
# Restores the monolithic no-further-modules posture once NVIDIA is in. Ordered
# after every boot-time module load AND after CC bring-up, so nvidia +
# nvidia_uvm are already resident. No Requires — this must latch even if GPU
# bring-up was skipped (e.g. a CPU-only boot of the GPU image), where it simply
# hardens a kernel that loaded nothing.
After=nvidia-cc-ready.service systemd-modules-load.service
# Whatever starts the latch also starts GPU bring-up, so After= above always
# has something to wait for. Wants, not Requires, for the reason given above.
Wants=nvidia-cc-ready.service
# Until the latch is set a validly signed module still loads, so nothing that
# hands out a root shell or starts a workload may run first. These units wait
# for the whole GPU bring-up sequence as a result. Each also requires the
# latch from its own 10-modules-latch.conf drop-in, which holds even if this
# unit cannot be loaded. Naming a unit a composition leaves out is harmless.
# attestation-api.service is left out on purpose: it gives no shell and runs
# no workload, and a verifier may need its GPU evidence before CC-ready,
# which this unit waits for.
Before=ssh.service containerd.service docker.service
# Fail closed when the sysctl write itself fails: power off at once, with no
# retry. See docs/module-signing.md for how to find the cause.
FailureAction=poweroff-force

[Service]
Type=oneshot
RemainAfterExit=yes
# One-way latch: once 1, it cannot be set back to 0 without a reboot. That is
# the point — no module may load for the rest of this boot.
ExecStart=/sbin/sysctl -w kernel.modules_disabled=1

# vsock fence: only attestation-api may use AF_VSOCK (see kernel/gpu.config).
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
