#!/usr/bin/env bash
set -euo pipefail

readonly ROOT=/opt/nccl-tests
readonly OUT="${1:-/var/lib/nccl-tests/results/$(date -u +%Y%m%dT%H%M%SZ)}"
readonly COMMON=(-b 8 -e 1G -f 2 -w 5 -n 20 -c 1)

if [[ "$EUID" -eq 0 ]]; then
    install -d -o nccl-test -g nccl-test "$OUT"
    cd /var/lib/nccl-tests
    exec runuser -u nccl-test -- "$0" "$OUT"
fi

mkdir -p "$OUT"
exec > >(tee -a "$OUT/run.log") 2>&1

export PATH=/usr/local/cuda/bin:$PATH
export LD_LIBRARY_PATH=/usr/local/cuda/lib:/usr/lib/x86_64-linux-gnu
export NCCL_DEBUG=INFO
export NCCL_DEBUG_SUBSYS=INIT,GRAPH,ENV
export NCCL_NVLS_ENABLE=0
export NCCL_CUMEM_HOST_ENABLE=0
export NCCL_ENV_PLUGIN=none

general-purpose-gpu-check | tee "$OUT/gpu-gate.txt"
gpu_count="$(nvidia-smi --query-gpu=index --format=csv,noheader | awk 'END {print NR}')"
if ! [[ "$gpu_count" =~ ^[1-9][0-9]*$ ]]; then
    echo "invalid initialized GPU count: $gpu_count" >&2
    exit 1
fi
nvidia-smi topo -m > "$OUT/topology.txt"
nvidia-smi nvlink -s > "$OUT/nvlink.txt"

timeout 900 "$ROOT/build-nompi/all_reduce_perf" "${COMMON[@]}" -g "$gpu_count" \
    | tee "$OUT/all-reduce-one-process.txt"
timeout 900 mpirun -np "$gpu_count" \
    "$ROOT/build-mpi/all_reduce_perf" "${COMMON[@]}" -g 1 \
    | tee "$OUT/all-reduce-mpi.txt"

for test in all_gather_perf reduce_scatter_perf; do
    timeout 900 "$ROOT/build-nompi/$test" "${COMMON[@]}" -g "$gpu_count" \
        | tee "$OUT/$test.txt"
done

for run in 1 2 3; do
    timeout 300 mpirun -np "$gpu_count" "$ROOT/build-mpi/all_reduce_perf" \
        -b 8 -e 64M -f 2 -w 2 -n 5 -c 1 -g 1 \
        | tee "$OUT/restart-$run.txt"
done

nvidia-smi conf-compute -q > "$OUT/conf-compute-after.txt"
echo "NCCL smoke matrix completed: $OUT"
