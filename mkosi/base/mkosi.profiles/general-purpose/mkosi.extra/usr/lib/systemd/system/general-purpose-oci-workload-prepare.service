[Unit]
Description=Keep Docker state on encrypted scratch for a launch-bound OCI workload
Documentation=https://github.com/confidential-dot-ai/confidential-os-builder/blob/main/docs/GENERAL-PURPOSE.md#oci-workloads
# Does nothing unless the launch-bound pubkey bundle names a workload.
ConditionPathExists=/run/confai/operator-pubkey
# Not Before=docker.socket: sockets start before basic.target, which this
# service follows, so that ordering is a cycle systemd breaks by dropping a
# job. docker.service is what reads daemon.json, and socket activation waits
# for it.
Before=docker.service

[Service]
Type=oneshot
ExecStart=/usr/lib/confai/general-purpose-oci-workload prepare
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target docker.service
