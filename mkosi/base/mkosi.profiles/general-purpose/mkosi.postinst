#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${BUILDROOT:-}" && "${CONFOS_CONTAINER_IN_CHROOT:-0}" != 1 ]]; then
    install -m0755 "$0" "$BUILDROOT/tmp/validate-workload"
    chroot "$BUILDROOT" /usr/bin/env CONFOS_CONTAINER_IN_CHROOT=1 /tmp/validate-workload
    rm -f "$BUILDROOT/tmp/validate-workload"
    exit 0
fi

for binary in containerd docker dockerd runc; do
    command -v "$binary" >/dev/null
done
dockerd --validate --config-file=/etc/docker/daemon.json
containerd --config /etc/containerd/config.toml config dump >/dev/null
