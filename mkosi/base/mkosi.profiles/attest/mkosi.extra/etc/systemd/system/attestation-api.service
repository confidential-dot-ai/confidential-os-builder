[Unit]
Description=TEE Attestation REST API
Documentation=https://github.com/confidential-dot-ai/attestation-rs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/attestation-api -c /etc/attestation-api/config.toml
Restart=on-failure
RestartSec=3
# SEV-SNP guests expose /dev/sev-guest; TDX guests expose /dev/tdx_guest
# (NOTE: kernel uses an underscore — naming differs from the platform
# string). Allowing both is harmless when one isn't present; the
# attestation-api binary probes for whichever is available at runtime.
DeviceAllow=/dev/sev-guest rwm
DeviceAllow=/dev/tdx_guest rwm
# Same sandbox as the attest-gpu variant (minus the GPU device grants).
# AF_VSOCK stays allowed: on TDX the quote is fetched from the host QGS over
# vsock (CID 2, port 4050); on SNP the family goes unused. UNIX for local
# plumbing, INET/INET6 for the HTTP endpoint, NETLINK for trivial ifquery
# paths libc may take.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_VSOCK
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
