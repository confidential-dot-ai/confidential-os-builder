[Unit]
Description=Attested RKE2 join-token release
Documentation=https://github.com/confidential-dot-ai/c8s
ConditionPathExists=/run/confos/role-server
# Retry indefinitely: a sealed image has no shell to restart a stopped
# unit; a broken attestation stack is visible in the journal instead.
StartLimitIntervalSec=0
# No rke2-server ordering: the handler 503s until the agent-token appears,
# so agents can poll while the control plane initialises. No network-online
# ordering: it only binds a wildcard socket.
After=rke2-role.service attestation-api.service
Requires=rke2-role.service attestation-api.service

[Service]
Type=simple
# token-path is where rke2-server materialises the agent-only token whose
# value 20-role.conf pins via RKE2_AGENT_TOKEN_FILE.
ExecStart=/usr/local/bin/c8s join-release \
    --listen :8444 \
    --token-path /var/lib/rancher/rke2/server/agent-token
Restart=on-failure
RestartSec=10
# Only ever reads the agent-token; a read-only FS view suffices.
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
