[Unit]
Description=RKE2 role dispatch from the joindata disk
# Role-gated units order After= this unit and condition on the
# /run/confos/role-* verdict it writes. Fail-closed is by ABSENCE of that
# marker (written last on each success path, on empty tmpfs), NOT by failure
# propagation: do NOT add Requires=/BindsTo= here, or a rejected disk turns
# clean condition-skips into cascading unit failures.

[Service]
Type=oneshot
ExecStart=/usr/local/bin/rke2-role.sh

[Install]
WantedBy=multi-user.target
