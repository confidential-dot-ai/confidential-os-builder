[Unit]
Description=TEE Attestation REST API (TDX + NVIDIA GPU)
Documentation=https://github.com/confidential-dot-ai/attestation-rs
After=network-online.target nvidia-cc-ready.service
Wants=network-online.target
# GPU evidence collection needs the driver up; ordered after CC bring-up.
Wants=nvidia-cc-ready.service

[Service]
Type=simple
ExecStart=/usr/local/bin/attestation-api -c /etc/attestation-api/config.toml
Restart=on-failure
RestartSec=3
# TDX quote device.
DeviceAllow=/dev/sev-guest rwm
DeviceAllow=/dev/tdx_guest rwm
# NVIDIA nodes the libnvat/NVML collector opens for SPDM evidence. The
# per-GPU /dev/nvidiaN nodes register major 195 as "nvidia" in /proc/devices,
# so the group rule is char-nvidia; "nvidia-frontend" resolves to nothing on
# current drivers and NVML then enumerates zero GPUs.
DeviceAllow=/dev/nvidiactl rwm
DeviceAllow=/dev/nvidia-uvm rwm
DeviceAllow=char-nvidia rwm
# Sandbox (incl. the vsock fence) comes from the base tree's
# attestation-api.service.d/10-sandbox.conf, shared with attest.

[Install]
WantedBy=multi-user.target
