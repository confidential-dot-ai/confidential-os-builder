#!/usr/bin/env bash
# mkosi sync hook for the attest-gpu profile. Same mechanism as the `attest`
# profile's sync (see its header for the full explanation of the oras +
# layer-extract approach and the mkosi.local staging convention) — the only
# difference is the image and that we pluck TWO artifacts out of it: the
# GPU-capable attestation-api binary AND NVIDIA's libnvat.so collector.
#
# The runtime artifact contains the GPU-enabled attestation-api binary and the
# exact libnvat/ICU ABI closure it was validated with. Always pull by digest:
# changing it changes the measured guest root and requires runtime validation.

set -euo pipefail

STAGE_DIR="$SRCDIR/mkosi.local/mkosi.extra"

# Pre-staged escape hatch: if a host-side step already dropped the binary +
# libnvat into mkosi.local (e.g. `bin/confos-fetch-attest-gpu` building against a
# local libnvat, before the GHCR image is published), trust it and skip the
# pull. This is how the profile is validated ahead of the first publish.
if [ -f "$STAGE_DIR/usr/local/bin/attestation-api" ] && \
   ls "$STAGE_DIR"/usr/lib/x86_64-linux-gnu/libnvat.so* >/dev/null 2>&1; then
    echo "attest-gpu: binary + libnvat already staged in mkosi.local — skipping pull."
    exit 0
fi

# Pinned digest of the GPU-capable attestation runtime. Bumping it changes the
# launch measurement of every --profile attest-gpu build.
IMAGE="ghcr.io/confidential-dot-ai/attestation-api-gpu@sha256:375136d59811b8d48dfbaa4e4f1ccd16c4a043c1051c4b881c8d0575236e5097"
ORAS_AUTH=()
if [ -f "$SRCDIR/mkosi.local/oras-auth.json" ]; then
    ORAS_AUTH=(--registry-config "$SRCDIR/mkosi.local/oras-auth.json")
fi
mkdir -p "${TMPDIR:=/tmp}"
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
EXTRACT="$TMP/rootfs"; mkdir -p "$EXTRACT"

MANIFEST=$(oras manifest fetch "${ORAS_AUTH[@]}" "$IMAGE")
REPO="${IMAGE%@*}"
echo "$MANIFEST" | jq -r '.layers[] | select(.mediaType | test("tar.?gzip$")) | .digest' | \
while read -r layer; do
    oras blob fetch "${ORAS_AUTH[@]}" --output "$TMP/layer.tgz" "${REPO}@${layer}"
    tar -xzf "$TMP/layer.tgz" -C "$EXTRACT" 2>/dev/null || true
    rm -f "$TMP/layer.tgz"
done

# attestation-api binary (entrypoint at image root in the confidential-dot-ai
# lineage; fall back to usr/local/bin for older layouts).
BIN=""
for c in "$EXTRACT/attestation-api" "$EXTRACT/usr/local/bin/attestation-api"; do
    [ -f "$c" ] && { BIN="$c"; break; }
done
[ -n "$BIN" ] || { echo "attest-gpu: attestation-api not found in image" >&2; exit 1; }
install -D -m0755 "$BIN" "$STAGE_DIR/usr/local/bin/attestation-api"

# The runtime artifact is a deliberately minimal usr/ tree containing libnvat
# and its versioned ABI dependencies. Preserve its symlinks and exact layout.
NVAT="$(find "$EXTRACT" -name 'libnvat.so.1.2.0' -print -quit)"
[ -n "$NVAT" ] || { echo "attest-gpu: libnvat.so not found in image" >&2; exit 1; }
cp -a "$EXTRACT/usr/." "$STAGE_DIR/usr/"

echo "attest-gpu: staged GPU attestation runtime from $IMAGE"
