#!/bin/bash
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

# Parse roothash from kernel cmdline (disable globbing to prevent expansion)
set -f
ROOTHASH=""
for param in $(cat /proc/cmdline); do
    case "$param" in
        roothash=*) ROOTHASH="${param#roothash=}" ;;
    esac
done
set +f

if [ -z "$ROOTHASH" ]; then
    echo "FATAL: no roothash= on kernel cmdline"
    sleep 5
    echo b > /proc/sysrq-trigger
    exit 1  # fallback if sysrq disabled
fi

# Normalize to lowercase and validate: SHA-256 (64), SHA-384 (96), or SHA-512 (128) hex
ROOTHASH=$(echo "$ROOTHASH" | tr '[:upper:]' '[:lower:]')
if ! echo "$ROOTHASH" | grep -qE '^[a-f0-9]{64}([a-f0-9]{32})?([a-f0-9]{32})?$'; then
    echo "FATAL: invalid roothash (expected 64/96/128 hex chars): $ROOTHASH"
    sleep 5
    echo b > /proc/sysrq-trigger
    exit 1  # fallback if sysrq disabled
fi

echo "initrd: setting up dm-verity with roothash=$ROOTHASH"

# Wait for virtio disk to appear (up to 30 seconds)
WAITED=0
while [ ! -e /dev/vda2 ] && [ "$WAITED" -lt 30 ]; do
    sleep 1
    WAITED=$((WAITED + 1))
done
if [ ! -e /dev/vda2 ]; then
    echo "FATAL: /dev/vda2 not found after ${WAITED}s"
    sleep 5
    echo b > /proc/sysrq-trigger
    exit 1  # fallback if sysrq disabled
fi

veritysetup open /dev/vda2 root /dev/vda3 "$ROOTHASH"
echo "initrd: dm-verity device created at /dev/mapper/root"

# Select the writable-state backing by virtio-block device serial (not a
# serial port). QEMU exposes this per-device identifier through the virtio
# descriptor, and Linux publishes it at /sys/block/<dev>/serial before I/O:
#   serial=confai-scratch -> ephemeral, encrypted with a random in-RAM key
#   anything else / none  -> 2G RAM tmpfs (writes lost on reboot)
#
# Unlike a filesystem label, the serial requires no pre-formatting. KubeVirt
# passes Disk.serial from the VM spec to QEMU, so the cluster declares the
# device's purpose in YAML and the guest sees it before boot. See src/qemu.rs
# for the matching `confos run` path.
SCRATCH_DEV=""
for dev in /dev/vdb /dev/vdc /dev/vdd; do
    [ -e "$dev" ] || continue
    SERIAL=$(cat "/sys/block/$(basename "$dev")/serial" 2>/dev/null || true)
    echo "initrd: examining $dev (serial=${SERIAL:-<none>})"
    if [ "$SERIAL" = "confai-scratch" ]; then
        SCRATCH_DEV="$dev"
        break
    fi
done

# Mount writable-state storage at $1, preferring the encrypted scratch disk
# and falling back to tmpfs.
mount_state_backing() {
    if [ -n "$SCRATCH_DEV" ]; then
        echo "initrd: found confai-scratch disk at $SCRATCH_DEV — ephemeral encrypted state"
        # Generate a per-boot key held only in guest RAM. SNP and TDX protect
        # that memory from the host; a plain VM provides no such guarantee.
        mkdir -p /run
        head -c 64 /dev/urandom > /run/scratch.key
        # A reused PVC may contain stale signatures. --batch-mode prevents
        # cryptsetup from waiting for input that the initrd cannot provide.
        # The fresh plain-mode key makes prior bytes unreadable, and mkfs.ext4
        # immediately replaces the filesystem metadata.
        cryptsetup open --batch-mode --type plain --cipher aes-xts-plain64 --key-size 512 \
            -d /run/scratch.key "$SCRATCH_DEV" scratch
        # Reformat every boot because the previous key no longer exists.
        mkfs.ext4 -q /dev/mapper/scratch
        mount /dev/mapper/scratch "$1"
    else
        echo "initrd: no confai-scratch disk found — 2G RAM tmpfs (writes lost on reboot)"
        mount -t tmpfs tmpfs "$1" -o size=2G,nosuid,nodev
    fi
}

# --- Root layout -------------------------------------------------------------
# The system runs directly from the verity mount. Only relative paths listed
# in the measured image's /usr/lib/confai/state.d/*.conf receive writable
# overlays; the base supplies defaults and profiles add separate files.
# Unlisted paths, including /usr and most of /etc, remain read-only. See
# docs/THREAT_MODEL.md for the security boundary.
mkdir -p /sysroot /state
mount -o ro /dev/mapper/root /sysroot
mount_state_backing /state

# A missing state directory is an image-build error. Fail the boot here
# instead of surfacing an unrelated EROFS error later in a service.
fail_state() {
    echo "FATAL: state.d: $1" >&2
    echo b > /proc/sysrq-trigger
    exit 1  # fallback if sysrq disabled
}

# Mount an overlay at $1 with its upper/work directories under /state/$2.
# The kernel resolves lowerdir=$1 before covering that mountpoint. The merged
# directory inherits mode and ownership from the upper layer, so copy them
# from the baked directory; otherwise /root becomes 0755 and /tmp loses 1777.
mount_overlay() {
    mkdir -p "/state/$2/upper" "/state/$2/work"
    chmod --reference="$1" "/state/$2/upper"
    chown --reference="$1" "/state/$2/upper"
    mount -t overlay overlay \
        -o "lowerdir=$1,upperdir=/state/$2/upper,workdir=/state/$2/work" "$1"
}

STATE_DIRS=""
for conf in /sysroot/usr/lib/confai/state.d/*.conf; do
    [ -e "$conf" ] || fail_state "no /usr/lib/confai/state.d/*.conf in the image"
    # Preserve a final unterminated line and strip CR from CRLF input.
    while read -r dir || [ -n "$dir" ]; do
        dir="${dir%$'\r'}"
        case "$dir" in "" | \#*) continue ;; esac
        case " $STATE_DIRS " in *" $dir "*) continue ;; esac
        [ -d "/sysroot/$dir" ] || fail_state "$dir listed in ${conf##*/} but not a directory in the image"
        mount_overlay "/sysroot/$dir" "${dir//\//-}"
        STATE_DIRS="$STATE_DIRS $dir"
    done < "$conf"
done
echo "initrd: state overlays mounted:$STATE_DIRS"

# Mount /run before switch_root with systemd's usual limits. PID 1 retains an
# existing /run, so data staged below survives into the booted system.
# Systemd also places the transient machine-id there because the baked
# /etc/machine-id is empty and read-only.
mount -t tmpfs tmpfs /sysroot/run -o mode=0755,size=20%,nr_inodes=800k,strictatime,nosuid,nodev

# Minimal runtime directories
mkdir -p /sysroot/run/dbus /sysroot/var/log/journal

# --- Operator-key binding: verify before switch_root -----------------------
# Bind a launch-supplied operator public key into the platform's launch
# identity so an external operator can attest that THIS node will only trust
# THEIR key, with no console, no pre-shared cluster secret, and no trust in
# the (untrusted) host that delivered the key. The launcher attaches a
# KubeVirt secret disk labelled "opkeydata" (an ISO9660 filesystem, same
# mechanism as cloud-init's "cidata") containing one file, `pubkey` — the raw
# operator public key. Two per-platform arms (c8s#331):
#
#   TDX: hash the key (SHA-384) and extend into RTMR[3] — the one
#   guest-controllable measurement register — via the tdx_guest sysfs.
#   Extend semantics: RTMR_new = SHA384(RTMR_old || data48), so the operator
#   verifies rtmr3 == SHA384(0x00*48 || SHA384(op_pub)) offline.
#
#   SNP: no runtime-extend register exists, so the binding is inverted — the
#   launcher committed sha256(pubkey) into the report's immutable HOSTDATA
#   field at launch, and we VERIFY here: read our own report via ConfigFS-TSM
#   (/sys/kernel/config/tsm/report, the sev-guest driver's file interface —
#   no ioctl binary needed; ~1s, fine for a one-shot check) and fail closed
#   unless HOSTDATA equals sha256 of the staged key. The report comes from
#   the PSP through the measured kernel — the same trust class as the TDX
#   sysfs. A keyless launch carries all-zero HOSTDATA, which no sha256
#   output equals, so a host that stripped the launcher-side binding is
#   caught here. HOSTDATA is 32 bytes at offset 192 in every accepted
#   report version.
#
# The initrd is the single place the key is hashed, so the credential-release
# service can later trust the pubkey off this same disk without a separate
# digest to cross-check: this initrd is measured, and it only binds the hash
# of the exact bytes it reads.
#
# Why a labelled secret disk and not a raw serial-tagged block device: the
# secret arrives as a file inside an ISO filesystem (KubeVirt's SecretVolume
# renders it that way), so it is read by mount+file, not by raw offset. This
# keeps the launcher side a plain Secret (no PVC lifecycle) at the cost of one
# labelled mount here. Guest kernel has ISO9660 (CONFIG_ISO9660_FS=y).
#
# This runs before switch_root, so no code from the measured root or writable
# state executes first. The binding is fixed for the guest's lifetime and
# reflects only the launch-supplied key.
#
# Fail-closed asymmetry (security-critical):
#   - no opkey disk                 -> skip (unbound node; a non-operator boot)
#   - disk present, binding FAILS   -> FATAL. Booting on with the key unbound
#     (TDX: RTMR[3] unextended; SNP: HOSTDATA not matching) when a key was
#     supplied would let the host strip or substitute the binding undetected.
RTMR3=/sys/devices/virtual/misc/tdx_guest/measurements/rtmr3:sha384
OPKEY_DEV=$(blkid -L opkeydata 2>/dev/null || true)

if [ -n "$OPKEY_DEV" ]; then
    echo "initrd: found opkeydata disk at $OPKEY_DEV — binding operator key"
    fail_opkey() {
        echo "FATAL: operator key supplied but binding failed: $1" >&2
        echo b > /proc/sysrq-trigger
        exit 1  # fallback if sysrq disabled
    }
    mkdir -p /opkey
    mount -o ro "$OPKEY_DEV" /opkey 2>/dev/null || fail_opkey "mount $OPKEY_DEV failed"
    [ -s /opkey/pubkey ] || fail_opkey "no /opkey/pubkey on disk"
    # Copy the key into the post-switch_root filesystem because the hardened
    # cred-release service cannot mount the ISO. The initrd stages exactly the
    # bytes it binds, and the service rechecks that platform binding.
    #
    # Stage under /run because /etc is read-only; the baked /etc/confai ->
    # /run/confai symlink preserves the consumer path. Bind the directory
    # read-only to prevent ordinary replacement. The consumer still verifies
    # the platform binding before trusting the key.
    mkdir -p /sysroot/run/confai
    cp /opkey/pubkey /sysroot/run/confai/operator-pubkey || fail_opkey "stage pubkey failed"
    chmod 0644 /sysroot/run/confai/operator-pubkey
    mount --bind /sysroot/run/confai /sysroot/run/confai \
        && mount -o remount,bind,ro /sysroot/run/confai \
        || fail_opkey "read-only bind of /run/confai failed"

    if [ -w "$RTMR3" ]; then
        # --- TDX arm: extend SHA-384(pubkey) into RTMR[3] ---
        # sha384sum prints "<hex>  -" -> 96 hex chars. Sole hash site.
        DIGEST_HEX=$(sha384sum < /opkey/pubkey | cut -d' ' -f1)
        case "$DIGEST_HEX" in
            *[!0-9a-f]* | "") fail_opkey "sha384sum produced non-hex" ;;
        esac
        [ "${#DIGEST_HEX}" = "96" ] || fail_opkey "digest is ${#DIGEST_HEX} hex chars, want 96"
        # Convert 96 hex chars -> 48 raw bytes in a tmpfs file, then write to
        # the extend node with dd in ONE 48-byte write(2): the node rejects any
        # other size, and bash printf splits its output at 0x0a bytes (~17% of
        # digests), so redirecting printf at the node fails for those keys.
        # sed turns "ab" into "\xab"; printf interprets the escapes.
        esc=$(printf '%s' "$DIGEST_HEX" | sed 's/../\\x&/g')
        # Intentional: $esc IS the format string — that's what interprets the
        # \x escapes into raw bytes. DIGEST_HEX is validated [0-9a-f]{96}
        # above, so $esc contains only \xNN sequences, no user-controlled
        # format directives.
        # shellcheck disable=SC2059
        printf "$esc" > /opkey-digest.bin
        n=$(wc -c < /opkey-digest.bin)
        [ "$n" = "48" ] || fail_opkey "digest converted to $n bytes, want 48"
        dd if=/opkey-digest.bin of="$RTMR3" bs=48 count=1 2>/dev/null \
            || fail_opkey "write to $RTMR3 rejected"
        rm -f /opkey-digest.bin
        echo "initrd: RTMR[3] extended with operator key digest $DIGEST_HEX"
    elif [ -c /dev/sev-guest ]; then
        # --- SNP arm: verify sha256(pubkey) == report.HOSTDATA ---
        WANT=$(sha256sum < /opkey/pubkey | cut -d' ' -f1)
        case "$WANT" in
            *[!0-9a-f]* | "") fail_opkey "sha256sum produced non-hex" ;;
        esac
        [ "${#WANT}" = "64" ] || fail_opkey "digest is ${#WANT} hex chars, want 64"
        mount -t configfs configfs /sys/kernel/config 2>/dev/null || true
        TSM=/sys/kernel/config/tsm/report/opkey
        mkdir -p "$TSM" 2>/dev/null || fail_opkey "no ConfigFS-TSM report dir (kernel lacks CONFIG_TSM_REPORTS?)"
        # 64 zero bytes of REPORTDATA: freshness is irrelevant here — HOSTDATA
        # is immutable and we read our own report through the kernel.
        dd if=/dev/zero bs=64 count=1 2>/dev/null > "$TSM/inblob" \
            || fail_opkey "TSM inblob write failed"
        # ONE read: outblob is generated per inblob write; a second read
        # returns nothing.
        cat "$TSM/outblob" > /opkey-report.bin || fail_opkey "TSM outblob read failed"
        n=$(wc -c < /opkey-report.bin)
        [ "$n" -ge 224 ] || fail_opkey "SNP report is $n bytes, want >= 224"
        GOT=$(dd if=/opkey-report.bin bs=1 skip=192 count=32 2>/dev/null | od -v -An -tx1 | tr -d ' \n')
        rm -f /opkey-report.bin
        rmdir "$TSM" 2>/dev/null || true
        [ "${#GOT}" = "64" ] || fail_opkey "HOSTDATA extraction got ${#GOT} hex chars, want 64"
        [ "$GOT" = "$WANT" ] || fail_opkey "HOSTDATA is $GOT but staged key implies $WANT (launcher stripped or substituted the binding)"
        echo "initrd: HOSTDATA verified against operator key digest $WANT"
    else
        fail_opkey "no binding mechanism: neither writable $RTMR3 nor /dev/sev-guest"
    fi
    umount /opkey 2>/dev/null || true
else
    echo "initrd: no opkeydata disk — node boots unbound"
fi

# --- IPE: make the exec policy final -----------------------------------------
# The kernel's compiled-in IPE policy lets only the initramfs and this image's
# dm-verity root execute (docs/THREAT_MODEL.md). Every securityfs control that
# could change that — enforce, success_audit, new_policy, policies/*/active —
# requires CAP_MAC_ADMIN, so drop it from the bounding set before switch_root:
# PID 1 and everything it spawns inherit the reduced set, and no process in
# the booted guest can switch enforcement off or activate another policy.
# Nothing the base image runs needs CAP_MAC_ADMIN. Skipped when the kernel was
# built without IPE, because privileged containers request every capability.
mount -t securityfs securityfs /sys/kernel/security 2>/dev/null || true
if [ -d /sys/kernel/security/ipe ]; then
    umount /sys/kernel/security
    echo "initrd: IPE active — dropping CAP_MAC_ADMIN, switching root..."
    exec setpriv --bounding-set -mac_admin switch_root /sysroot /sbin/init
fi
umount /sys/kernel/security 2>/dev/null || true
echo "initrd: kernel has no IPE — exec policy not enforced; switching root..."
exec switch_root /sysroot /sbin/init
