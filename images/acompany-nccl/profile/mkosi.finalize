#!/bin/bash
set -euo pipefail

# systemd-sysusers creates acompany-test under the reproducible
# SOURCE_DATE_EPOCH, so its shadow "last change" day is 0. PAM reads day 0
# as "password expired, change it now", which blocks even key-based ssh
# logins ("Password change required but no TTY available"). Pin the same
# fixed day root's baked entry carries; the account stays passwordless
# (locked hash) and the image stays byte-reproducible.
shadow="$BUILDROOT/etc/shadow"
grep -q '^acompany-test:' "$shadow"
sed -i 's/^\(acompany-test:[^:]*\):0:/\1:19800:/' "$shadow"
grep -q '^acompany-test:[^:]*:19800:' "$shadow"

# The Acompany profile overlays all of /etc so apt/dpkg can behave normally.
# Drop the inherited narrower /etc/ssh overlay: mounting both a parent and its
# child wastes state and makes the resulting mount hierarchy order-dependent.
rm -f "$BUILDROOT/usr/lib/confai/state.d/50-ssh.conf"

# CUDA 13.2 installs its runtime libraries in lib/, not lib64/. Register that
# measured path in the image's linker cache so NCCL and vLLM work outside an
# interactive shell without relying on LD_LIBRARY_PATH.
echo /usr/local/cuda/lib > "$BUILDROOT/etc/ld.so.conf.d/acompany-cuda.conf"
chroot "$BUILDROOT" /sbin/ldconfig
