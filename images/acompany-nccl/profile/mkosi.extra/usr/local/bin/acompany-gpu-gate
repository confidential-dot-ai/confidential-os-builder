#!/usr/bin/env bash
set -euo pipefail

expected="${ACOMPANY_EXPECTED_GPUS:-}"
if [[ -z "$expected" ]]; then
    expected="$(lspci -Dnnd 10de:3182 | wc -l)"
fi
if ! [[ "$expected" =~ ^[1-9][0-9]*$ ]]; then
    echo "invalid expected GPU count: $expected" >&2
    exit 1
fi

actual="$(nvidia-smi --query-gpu=index --format=csv,noheader | wc -l)"
if [[ "$actual" -ne "$expected" ]]; then
    echo "expected $expected initialized B300 GPU(s), found $actual" >&2
    exit 1
fi

nvidia-smi -L
nvidia-smi conf-compute -q
nvidia-smi topo -m

if nvidia-smi conf-compute -q | grep -Eiq 'devtools[^:]*:[[:space:]]*(on|enabled|true)'; then
    echo "GPU devtools mode is enabled" >&2
    exit 1
fi

echo "$actual-GPU visibility and production-mode gate passed"
